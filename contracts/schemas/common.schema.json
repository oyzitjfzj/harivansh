{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noerith:schema:common:0.1.0",
  "title": "NOERITH Common Protected Contract Types",
  "description": "Reference-candidate primitives for S00. This schema does not lock the final wire format, hash algorithm, clock topology, or transport. Duplicate JSON member rejection is a parser-level requirement.",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque stable identifier. Consumers must not infer authority or trust from its spelling."
    },
    "Ref": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque reference identifier."
    },
    "SemVer": {
      "type": "string",
      "minLength": 1,
      "description": "Semantic-version value; exact semantic validation is enforced by typed runtime validation."
    },
    "Digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "description": "Algorithm-labelled digest; the production digest algorithm is not locked by this file."
    },
    "VersionedRef": {
      "type": "object",
      "required": ["ref", "version"],
      "properties": {
        "ref": {"$ref": "#/$defs/Ref"},
        "version": {
          "type": ["string", "integer"],
          "description": "Opaque version token; integer must be non-negative.",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "DigestRef": {
      "type": "object",
      "required": ["ref", "digest"],
      "properties": {
        "ref": {"$ref": "#/$defs/Ref"},
        "digest": {"$ref": "#/$defs/Digest"}
      },
      "additionalProperties": false
    },
    "VersionedDigestRef": {
      "type": "object",
      "required": ["ref", "version", "digest"],
      "properties": {
        "ref": {"$ref": "#/$defs/Ref"},
        "version": {"type": ["string", "integer"], "minimum": 0},
        "digest": {"$ref": "#/$defs/Digest"}
      },
      "additionalProperties": false
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "description": "Wall-clock instant. Runtime code must not use wall time alone to order protected causal conflicts."
    },
    "NonNegativeInteger": {"type": "integer", "minimum": 0},
    "PositiveInteger": {"type": "integer", "minimum": 1},
    "StringSet": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "RefSet": {
      "type": "array",
      "items": {"$ref": "#/$defs/Ref"},
      "uniqueItems": true
    }
  }
}
