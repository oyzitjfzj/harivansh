{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noerith:schema:control-evidence:0.1.0",
  "title": "NOERITH Interrupt, Observation, Mirror and DispatchAttempt contracts v0.1",
  "description": "Source-faithful machine representation of the remaining Foundation catalog records. Nested shapes whose wire encoding is not locked are presence-checked rather than invented.",
  "$defs": {
    "OpaqueRequiredValue": {
      "$comment": "Presence is normative; exact nested encoding remains a qualification item."
    },
    "InterruptEvent": {
      "type": "object",
      "required": [
        "interrupt_id",
        "type",
        "issuer_principal_context",
        "target_work_refs",
        "target_effect_intent_refs",
        "requested_boundary",
        "correction_desired_state_ref",
        "causation_id",
        "causal_parents",
        "occurred_at",
        "observed_at",
        "logical_stamp",
        "authentication_authority_evidence",
        "reason_code",
        "handling_state",
        "handling_evidence_refs"
      ],
      "properties": {
        "interrupt_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "type": {"enum": ["pause", "cancel", "revoke", "correct", "supersede", "emergency-stop"]},
        "issuer_principal_context": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/DigestRef"},
        "target_work_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "target_effect_intent_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "requested_boundary": {"enum": ["lane", "task", "future-dispatch", "external-cancel", "all-applicable"]},
        "correction_desired_state_ref": {"type": ["string", "null"]},
        "causation_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "causal_parents": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "occurred_at": {"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/UncertainInstant"},
        "observed_at": {"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/UncertainInstant"},
        "logical_stamp": {"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/LogicalStamp"},
        "authentication_authority_evidence": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "reason_code": {"type": "string", "minLength": 1},
        "handling_state": {"enum": ["received", "applied", "partially-applied", "too-late", "conflicted", "unknown"]},
        "handling_evidence_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"}
      },
      "additionalProperties": false
    },
    "ObservationRecord": {
      "type": "object",
      "required": [
        "observation_id",
        "effect_intent_or_state_claim_ref",
        "observer",
        "source_resource_account_refs",
        "observation_method",
        "capability_version",
        "observed_at",
        "source_event_time",
        "freshness_valid_until",
        "result_schema",
        "canonical_digest",
        "result",
        "confidence_calibration_profile_ref",
        "independence_relation_to_actor",
        "evidence_refs",
        "lineage_privacy_retention_refs",
        "integrity"
      ],
      "properties": {
        "observation_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "effect_intent_or_state_claim_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "observer": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "source_resource_account_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "observation_method": {"type": "string", "minLength": 1},
        "capability_version": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "observed_at": {"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/UncertainInstant"},
        "source_event_time": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "freshness_valid_until": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "result_schema": {"type": "string", "minLength": 1},
        "canonical_digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"},
        "result": {"enum": ["confirmed", "contradicted", "pending", "partial", "unavailable", "unknown"]},
        "confidence_calibration_profile_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "independence_relation_to_actor": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "evidence_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "lineage_privacy_retention_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "integrity": {"$ref": "#/$defs/OpaqueRequiredValue"}
      },
      "additionalProperties": false
    },
    "MirrorVerdict": {
      "type": "object",
      "required": [
        "verdict_id",
        "scope",
        "candidate_digest",
        "checked_goal_version",
        "correction_frontier",
        "checked_principal_context_digest",
        "checked_state_preconditions",
        "checked_policy_authority_refs",
        "checked_target_payload_capability_refs",
        "risk_profile",
        "checker_profile",
        "result",
        "mismatch_codes",
        "evidence_refs",
        "valid_until",
        "invalidation_triggers"
      ],
      "properties": {
        "verdict_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "scope": {"enum": ["step", "trajectory"]},
        "candidate_digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"},
        "checked_goal_version": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "correction_frontier": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "checked_principal_context_digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"},
        "checked_state_preconditions": {"type": "array", "items": {"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/StatePrecondition"}},
        "checked_policy_authority_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "checked_target_payload_capability_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "risk_profile": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "checker_profile": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "result": {"enum": ["pass", "replan", "ask", "block", "escalate", "unresolved"]},
        "mismatch_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "valid_until": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "invalidation_triggers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "DispatchAttempt": {
      "type": "object",
      "required": [
        "attempt_id",
        "effect_intent_id",
        "decision_snapshot",
        "dispatch_claim_revision",
        "fencing_token",
        "adapter",
        "capability",
        "environment",
        "credential_handle_ref",
        "provider_idempotency_key",
        "request_digest",
        "started_at",
        "monotonic_deadline",
        "transport_result",
        "provider_status_receipt_refs",
        "next_action"
      ],
      "properties": {
        "attempt_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "effect_intent_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "decision_snapshot": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/DigestRef"},
        "dispatch_claim_revision": {"type": "integer", "minimum": 0},
        "fencing_token": {"type": ["integer", "string"]},
        "adapter": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "capability": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "environment": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "credential_handle_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "provider_idempotency_key": {"type": "string", "minLength": 1},
        "request_digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"},
        "started_at": {"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/UncertainInstant"},
        "monotonic_deadline": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "transport_result": {"enum": ["not-sent-proven", "response-received", "response-lost", "connection-failed-ambiguous", "local-abort"]},
        "provider_status_receipt_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "next_action": {"enum": ["none", "retry-same-intent", "reconcile", "manual-review"]}
      },
      "additionalProperties": false
    }
  }
}
