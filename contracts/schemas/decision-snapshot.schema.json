{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noerith:schema:decision-snapshot:0.1.0",
  "title": "NOERITH DecisionSnapshot v0.1",
  "description": "Immutable pre-commit snapshot. Composite source phrases such as 'ref + digest' are represented as nested reference objects; this is a reference schema representation, not a production wire-format lock.",
  "type": "object",
  "required": [
    "snapshot_id", "principal_context", "delegation_chain", "auth_fresh_until", "revocation_epoch",
    "operation_type", "effect_intent_id", "goal", "latest_correction_event_ref", "work", "causal_frontier",
    "state_preconditions", "lease", "targets", "intended_audience", "payload", "data_use", "effect_class",
    "consequence", "policy_decision", "authority_grant", "consent_receipt", "mirror_verdict", "obligations",
    "execution_capability", "execution_environment", "adapter_assurance_profile", "expected_evidence_plan_ref",
    "interrupt_watermark", "created_at", "expires_at", "snapshot_digest", "issuer_integrity"
  ],
  "properties": {
    "snapshot_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
    "principal_context": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/DigestRef"},
    "delegation_chain": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/DigestRef"},
    "auth_fresh_until": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"},
    "revocation_epoch": {"type": "integer"},
    "operation_type": {"type": "string", "minLength": 1},
    "effect_intent_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
    "goal": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedRef"},
    "latest_correction_event_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
    "work": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedRef"},
    "causal_frontier": {"$comment": "Exact frontier encoding remains a schema qualification detail; semantic presence is mandatory."},
    "state_preconditions": {
      "type": "array",
      "items": {"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/StatePrecondition"}
    },
    "lease": {
      "anyOf": [
        {
          "type": "object",
          "required": ["ref", "fencing_token"],
          "properties": {
            "ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
            "fencing_token": {"type": ["string", "integer"]}
          },
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    },
    "targets": {
      "type": "object",
      "required": ["resources", "accounts", "principals"],
      "properties": {
        "resources": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "accounts": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "principals": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"}
      },
      "additionalProperties": false
    },
    "intended_audience": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
    "payload": {
      "type": "object",
      "required": ["schema", "canonical_digest"],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "canonical_digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"}
      },
      "additionalProperties": false
    },
    "data_use": {
      "type": "object",
      "required": ["data_classes", "purpose", "disclosure_scope"],
      "properties": {
        "data_classes": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/StringSet"},
        "purpose": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "disclosure_scope": {"$comment": "Audience/provider scope shape is defined by information-lifecycle schema work."}
      },
      "additionalProperties": false
    },
    "effect_class": {"type": "string", "minLength": 1},
    "consequence": {
      "type": "object",
      "required": ["ref", "reversibility_class"],
      "properties": {
        "ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "reversibility_class": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "policy_decision": {
      "type": "object",
      "required": ["ref", "digest", "valid_until"],
      "properties": {
        "ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"},
        "valid_until": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"}
      },
      "additionalProperties": false
    },
    "authority_grant": {
      "type": "object",
      "required": ["ref", "digest", "remaining_use_marker"],
      "properties": {
        "ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"},
        "remaining_use_marker": {"type": ["string", "integer", "null"]}
      },
      "additionalProperties": false
    },
    "consent_receipt": {
      "anyOf": [
        {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/DigestRef"},
        {"type": "null"}
      ]
    },
    "mirror_verdict": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/DigestRef"},
    "obligations": {
      "type": "object",
      "required": ["required", "satisfaction_evidence_refs"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "satisfaction_evidence_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"}
      },
      "additionalProperties": false
    },
    "execution_capability": {
      "type": "object",
      "required": ["ref", "version", "provenance"],
      "properties": {
        "ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "version": {"type": ["string", "integer"]},
        "provenance": {"$comment": "Capability/tool/adapter provenance exact subshape remains capability-manifest schema work."}
      },
      "additionalProperties": false
    },
    "execution_environment": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedRef"},
    "adapter_assurance_profile": {"$comment": "AdapterAssuranceProfile is pinned here; exact profile schema is part of effect/adapter conformance work."},
    "expected_evidence_plan_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
    "interrupt_watermark": {"$comment": "Exact watermark representation is not specified by the source contract and is intentionally not invented here."},
    "created_at": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"},
    "expires_at": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"},
    "snapshot_digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"},
    "issuer_integrity": {"$comment": "Exact issuer-integrity mechanism qualifies with O-FC-02."}
  },
  "additionalProperties": false,
  "$comment": "Cross-field canonical digest equality, freshness, authority consumption, fence validity and current-state checks are S01 semantics."
}
