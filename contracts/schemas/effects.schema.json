{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noerith:schema:effects:0.1.0",
  "title": "NOERITH EffectIntent and AdapterAssuranceProfile v0.1",
  "description": "Source-faithful S00 machine representation of Foundation durable-effect contracts. The E0-E5 class is derived from qualified capability evidence; it is not itself sufficient assurance.",
  "$defs": {
    "OpaqueRequiredValue": {"$comment": "Presence is required by the source contract; exact nested wire shape remains a qualification item."},
    "AdapterAssuranceProfile": {
      "type": "object",
      "required": ["mutates_external_state", "accepts_stable_idempotency_key", "dedup_retention", "returns_acceptance_receipt", "status_query", "callback_semantics", "cancel_before_acceptance", "cancel_after_acceptance", "compensation", "transaction_boundary", "maximum_request_age_replay_controls", "known_ambiguity_failure_modes"],
      "properties": {
        "mutates_external_state": {"type": "boolean"},
        "accepts_stable_idempotency_key": {"type": "boolean"},
        "dedup_retention": {"type": "string", "minLength": 1, "$comment": "Duration encoding remains open; literal 'unknown' is allowed."},
        "returns_acceptance_receipt": {"enum": ["none", "opaque", "verifiable"]},
        "status_query": {"enum": ["none", "by_intent", "by_provider_id", "observable-state"]},
        "callback_semantics": {"enum": ["none", "signed", "replay-protected"]},
        "cancel_before_acceptance": {"enum": ["supported", "unsupported", "unknown"]},
        "cancel_after_acceptance": {"enum": ["supported", "best-effort", "unsupported", "unknown"]},
        "compensation": {"enum": ["none", "semantic-undo", "compensating-action"]},
        "transaction_boundary": {"enum": ["none", "provider-local", "shared-atomic"]},
        "maximum_request_age_replay_controls": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "known_ambiguity_failure_modes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "EffectIntent": {
      "type": "object",
      "required": ["effect_intent_id", "operation_type", "principal_context", "goal", "work", "targets", "payload", "purpose", "data_disclosure_classes", "effect_class", "reversibility", "adapter", "idempotency_key", "expected_evidence_plan_ref", "created_by_message_ref", "lifecycle_state", "decision_snapshot_refs", "dispatch_attempts", "provider_receipts", "observation_refs", "cancellation_record", "compensation_record", "current_fence"],
      "properties": {
        "effect_intent_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "operation_type": {"type": "string", "minLength": 1},
        "principal_context": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/DigestRef"},
        "goal": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedRef"},
        "work": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedRef"},
        "targets": {
          "type": "object",
          "required": ["resources", "accounts", "principals"],
          "properties": {
            "resources": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
            "accounts": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
            "principals": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"}
          },
          "additionalProperties": false
        },
        "payload": {
          "type": "object",
          "required": ["schema", "canonical_digest", "value_ref"],
          "properties": {
            "schema": {"type": "string", "minLength": 1},
            "canonical_digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"},
            "value_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}
          },
          "additionalProperties": false
        },
        "purpose": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "data_disclosure_classes": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "effect_class": {"enum": ["read", "local-write", "external-reversible", "external-consequential", "irreversible/high-impact"]},
        "reversibility": {"enum": ["reversible", "compensatable", "cancellable-before-accept", "irreversible", "unknown"]},
        "adapter": {
          "type": "object",
          "required": ["ref", "version", "assurance_profile"],
          "properties": {
            "ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
            "version": {"type": ["string", "integer"]},
            "assurance_profile": {"$ref": "#/$defs/AdapterAssuranceProfile"}
          },
          "additionalProperties": false
        },
        "idempotency_key": {"type": "string", "minLength": 1, "$comment": "Use literal 'unsupported' when the adapter has no stable key; exact key grammar remains adapter-specific."},
        "expected_evidence_plan_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "created_by_message_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "lifecycle_state": {"enum": ["PROPOSED", "PREPARED", "AUTHORIZED", "COMMIT_READY", "DISPATCHING", "REJECTED_NO_EFFECT", "ACCEPTED", "ACCEPTANCE_UNKNOWN", "RECONCILING", "UNRESOLVED", "OUTCOME_PENDING", "SUCCEEDED", "FAILED_AFTER_ACCEPT", "OUTCOME_UNKNOWN", "CANCELLED_PRECOMMIT", "STALE", "ABANDONED"]},
        "decision_snapshot_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "dispatch_attempts": {"type": "array", "items": {"$ref": "#/$defs/OpaqueRequiredValue"}},
        "provider_receipts": {"type": "array", "items": {"$ref": "#/$defs/OpaqueRequiredValue"}},
        "observation_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "cancellation_record": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "compensation_record": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "current_fence": {"type": ["string", "integer", "null"]}
      },
      "additionalProperties": false
    }
  }
}
