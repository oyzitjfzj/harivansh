{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noerith:schema:information-lifecycle:0.2.0",
  "title": "NOERITH Information Lineage, Trust and Lifecycle Records v0.2",
  "$defs": {
    "Version": {"type": ["string", "integer"]},
    "OpaqueRequiredValue": {
      "$comment": "The source contract requires this value but does not yet lock its nested wire representation. Presence is enforced without inventing structure."
    },
    "SourceRecord": {
      "type": "object",
      "required": [
        "namespace", "source_id", "version", "source_kind", "original_blob_ref", "media_type", "byte_length",
        "digest_profile", "digest", "capture_actor", "subject_refs", "owner_refs", "account_refs", "source_locator_ref",
        "captured_at", "source_time", "exact_span_scheme", "transcript_or_ocr_derivation_refs", "issuer_integrity_evidence",
        "truth_evidence_refs", "data_use_label_ref", "trust_taint_label_ref", "lifecycle_head_ref", "lifecycle_epoch",
        "key_scope_ref", "predecessor_ref", "correction_event_ref"
      ],
      "properties": {
        "namespace": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "source_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "version": {"$ref": "#/$defs/Version"},
        "source_kind": {"type": "string", "minLength": 1},
        "original_blob_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "media_type": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 0},
        "digest_profile": {"type": "string", "minLength": 1},
        "digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"},
        "capture_actor": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "subject_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "owner_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "account_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "source_locator_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "captured_at": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"},
        "source_time": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"}, {"const": "unknown"}]},
        "exact_span_scheme": {"type": "string", "minLength": 1},
        "transcript_or_ocr_derivation_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "issuer_integrity_evidence": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "truth_evidence_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "data_use_label_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "trust_taint_label_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "lifecycle_head_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "lifecycle_epoch": {"type": "integer", "minimum": 0},
        "key_scope_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "predecessor_ref": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}, {"type": "null"}]},
        "correction_event_ref": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "InformationNode": {
      "type": "object",
      "required": [
        "namespace", "node_id", "version", "kind", "content", "influence_parent_refs", "derivation_activity_ref",
        "supporting_claim_groups", "contradiction_refs", "source_span_refs", "generator_manifest_ref", "data_use_label_ref",
        "trust_taint_label_ref", "valid_time_interval", "recorded_time_interval", "use_state", "erasure_state", "lifecycle_epoch",
        "copy_registry_refs", "admission_evidence_ref"
      ],
      "properties": {
        "namespace": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "node_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "version": {"$ref": "#/$defs/Version"},
        "kind": {"type": "string", "minLength": 1},
        "content": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/DigestRef"},
        "influence_parent_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "derivation_activity_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "supporting_claim_groups": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "contradiction_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "source_span_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "generator_manifest_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "data_use_label_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "trust_taint_label_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "valid_time_interval": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "recorded_time_interval": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "use_state": {"type": "string", "minLength": 1},
        "erasure_state": {"type": "string", "minLength": 1},
        "lifecycle_epoch": {"type": "integer", "minimum": 0},
        "copy_registry_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "admission_evidence_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}
      },
      "additionalProperties": false
    },
    "DerivationActivity": {
      "type": "object",
      "required": [
        "activity_id", "actor_workload_ref", "purpose", "algorithm", "manifest_refs", "configuration_digest", "inputs",
        "exact_output_refs", "started_at", "completed_at", "parent_epoch_vector", "context_manifest_ref",
        "disclosure_receipt_refs", "validation_evidence_refs", "protected_commit_event_ref"
      ],
      "properties": {
        "activity_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "actor_workload_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "purpose": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "algorithm": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedRef"},
        "manifest_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet", "$comment": "Model/provider/tool manifests."},
        "configuration_digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"},
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "role"],
            "properties": {
              "ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
              "role": {"enum": ["data-input", "control-input", "support-evidence", "contradiction-evidence", "correction"]}
            },
            "additionalProperties": false
          }
        },
        "exact_output_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "started_at": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"},
        "completed_at": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"},
        "parent_epoch_vector": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "context_manifest_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "disclosure_receipt_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "validation_evidence_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "protected_commit_event_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}
      },
      "additionalProperties": false
    },
    "MemoryRecord": {
      "type": "object",
      "required": [
        "namespace", "node_id", "version", "kind", "content", "influence_parent_refs", "derivation_activity_ref",
        "supporting_claim_groups", "contradiction_refs", "source_span_refs", "generator_manifest_ref", "data_use_label_ref",
        "trust_taint_label_ref", "valid_time_interval", "recorded_time_interval", "use_state", "erasure_state", "lifecycle_epoch",
        "copy_registry_refs", "admission_evidence_ref", "memory_kind", "subject_binding", "scope", "validity_interval", "assertion",
        "status", "confidence_profile_ref", "explicit_user_confirmation_ref", "related_goal_work_refs", "retrieval_features",
        "correction_links", "original_source_support_refs"
      ],
      "properties": {
        "namespace": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "node_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "version": {"$ref": "#/$defs/Version"},
        "kind": {"type": "string", "minLength": 1},
        "content": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/DigestRef"},
        "influence_parent_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "derivation_activity_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "supporting_claim_groups": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "contradiction_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "source_span_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "generator_manifest_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "data_use_label_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "trust_taint_label_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "valid_time_interval": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "recorded_time_interval": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "use_state": {"type": "string", "minLength": 1},
        "erasure_state": {"type": "string", "minLength": 1},
        "lifecycle_epoch": {"type": "integer", "minimum": 0},
        "copy_registry_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "admission_evidence_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "memory_kind": {"type": "string", "minLength": 1},
        "subject_binding": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "scope": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "validity_interval": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "assertion": {"enum": ["stated", "observed", "inferred", "hypothetical"]},
        "status": {"enum": ["candidate", "admitted", "disputed", "superseded"]},
        "confidence_profile_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "explicit_user_confirmation_ref": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}, {"type": "null"}]},
        "related_goal_work_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "retrieval_features": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "correction_links": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "original_source_support_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"}
      },
      "additionalProperties": false
    },
    "DataUseLabel": {
      "type": "object",
      "required": [
        "owners", "subjects", "tenant_account_binding", "allowed_purposes", "allowed_audiences", "allowed_processors",
        "allowed_placements", "sensitivity_classes", "obligations", "retention_rules", "valid_until", "authority_refs",
        "policy_version_refs", "label_version"
      ],
      "properties": {
        "owners": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "subjects": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "tenant_account_binding": {"$ref": "#/$defs/OpaqueRequiredValue"},
        "allowed_purposes": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "allowed_audiences": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "allowed_processors": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "allowed_placements": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/StringSet"},
        "sensitivity_classes": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/StringSet"},
        "obligations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "retention_rules": {"type": "array", "items": {}},
        "valid_until": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"}, {"type": "null"}]},
        "authority_refs": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/RefSet"},
        "policy_version_refs": {"type": "array", "items": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedRef"}},
        "label_version": {"$ref": "#/$defs/Version"}
      },
      "additionalProperties": false
    },
    "CopyRecord": {
      "type": "object",
      "required": [
        "copy_id", "node", "copy_kind", "custodian", "locator_or_provider_request_ref", "encryption_key_scope", "created_at",
        "allowed_purpose", "retention_contract_ref", "lifecycle_epoch_seen", "purge_capability", "purge_state", "purge_receipt_ref", "residual_reason"
      ],
      "properties": {
        "copy_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
        "node": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedRef"},
        "copy_kind": {"type": "string", "minLength": 1},
        "custodian": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "locator_or_provider_request_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "encryption_key_scope": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "created_at": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"},
        "allowed_purpose": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "retention_contract_ref": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "lifecycle_epoch_seen": {"type": "integer", "minimum": 0},
        "purge_capability": {"type": "string", "minLength": 1},
        "purge_state": {"type": "string", "minLength": 1},
        "purge_receipt_ref": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}, {"type": "null"}]},
        "residual_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
