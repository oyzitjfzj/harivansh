{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noerith:schema:principal-context:0.1.0",
  "title": "NOERITH PrincipalContext v0.1",
  "type": "object",
  "required": [
    "context_id",
    "tenant_namespace",
    "subject_principals",
    "controlling_principal",
    "device_ref",
    "session_ref",
    "delegation_chain_ref",
    "assurance",
    "auth_fresh_until",
    "revocation_epoch",
    "audience",
    "issued_at",
    "expires_at",
    "provenance"
  ],
  "properties": {
    "context_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
    "tenant_namespace": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
    "subject_principals": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}
    },
    "controlling_principal": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
    "speaker_principal": {
      "$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref",
      "$comment": "Conditionally required for voice/human input. The source contract does not define a discriminator field, so that condition is enforced by semantic validation rather than invented here."
    },
    "acting_workload": {
      "$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref",
      "$comment": "Conditionally required for execution."
    },
    "device_ref": {
      "anyOf": [
        {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        {"type": "null"}
      ]
    },
    "session_ref": {
      "anyOf": [
        {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        {"type": "null"}
      ]
    },
    "target_principals": {
      "type": "array",
      "items": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
      "$comment": "Conditionally required for protected action."
    },
    "target_accounts": {
      "type": "array",
      "items": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
      "$comment": "Conditionally required for external action."
    },
    "delegation_chain_ref": {
      "$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id",
      "$comment": "Source contract permits an ID or the self marker."
    },
    "assurance": {"$ref": "#/$defs/AssuranceVector"},
    "auth_event_ref": {
      "$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id",
      "$comment": "Conditionally required when authenticated."
    },
    "auth_fresh_until": {
      "anyOf": [
        {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"},
        {"type": "null"}
      ]
    },
    "revocation_epoch": {"type": "integer"},
    "purpose_ref": {
      "$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id",
      "$comment": "Conditionally required for private/delegated use."
    },
    "audience": {
      "type": "array",
      "items": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}
    },
    "issued_at": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"},
    "expires_at": {
      "anyOf": [
        {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Instant"},
        {"type": "null"}
      ]
    },
    "provenance": {"$ref": "#/$defs/Provenance"}
  },
  "additionalProperties": false,
  "$defs": {
    "AssuranceVector": {
      "type": "object",
      "required": [
        "identity_proofing_level",
        "authentication_level",
        "federation_level",
        "speaker_binding",
        "session_freshness",
        "device_integrity",
        "workload_identity",
        "delegation_freshness"
      ],
      "properties": {
        "identity_proofing_level": {"enum": ["unknown", "low", "medium", "high", "external-profile"]},
        "authentication_level": {"enum": ["none", "single", "multi", "phishing-resistant", "external-profile"]},
        "federation_level": {"enum": ["local", "asserted", "protected", "externally-profiled"]},
        "speaker_binding": {"enum": ["unresolved", "probable", "verified", "not-applicable"]},
        "session_freshness": {"enum": ["stale", "acceptable", "fresh", "step-up-fresh"]},
        "device_integrity": {"enum": ["unknown", "registered", "attested", "degraded"]},
        "workload_identity": {"enum": ["absent", "authenticated", "attested"]},
        "delegation_freshness": {"enum": ["none", "current", "stale", "revoked"]}
      },
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "required": ["issuer", "evidence_refs", "digest"],
      "properties": {
        "issuer": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}
        },
        "digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"}
      },
      "additionalProperties": false
    }
  }
}
