{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noerith:schema:protected-envelope:0.1.0",
  "title": "NOERITH ProtectedEnvelope v0.1",
  "type": "object",
  "required": [
    "envelope_version", "message_id", "kind", "message_type", "message_type_version", "tenant_namespace",
    "producer_principal", "subject_refs", "intended_consumers", "correlation_id", "causation_id", "causal_parents",
    "occurred_at", "observed_at", "recorded_at", "logical_stamp", "goal", "correction_frontier", "work",
    "state_preconditions", "lineage", "policy_decision", "authority_grant", "decision_snapshot", "effect_intent_ref",
    "capability", "evidence_plan_ref", "payload_schema", "payload_digest", "payload", "sensitivity", "purpose",
    "disclosure_scope", "retention_class", "trust_taint", "deduplication_scope", "expiry_or_max_age", "trace_context",
    "integrity", "extensions"
  ],
  "properties": {
    "envelope_version": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/SemVer"},
    "message_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
    "kind": {"type": "string", "minLength": 1},
    "message_type": {"type": "string", "minLength": 1},
    "message_type_version": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/SemVer"},
    "tenant_namespace": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
    "producer_principal": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
    "producer_workload_instance": {
      "$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref",
      "$comment": "Conditionally required for a machine producer; semantic validator enforces the condition without inventing a new discriminator."
    },
    "subject_refs": {"type": "array", "items": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}},
    "intended_consumers": {"type": "array", "items": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}},
    "correlation_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id"},
    "causation_id": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Id", "$comment": "The root marker is a valid source-level alternative."},
    "causal_parents": {"type": "array", "items": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}},
    "occurred_at": {
      "anyOf": [
        {"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/UncertainInstant"},
        {"const": "unknown"}
      ]
    },
    "observed_at": {"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/UncertainInstant"},
    "recorded_at": {"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/UncertainInstant"},
    "logical_stamp": {"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/LogicalStamp"},
    "principal_context": {
      "$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedDigestRef",
      "$comment": "Conditionally required by the Foundation contract."
    },
    "goal": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedRef"}, {"type": "null"}]},
    "correction_frontier": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}, {"type": "null"}]},
    "work": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedRef"}, {"type": "null"}]},
    "state_preconditions": {
      "type": "array",
      "items": {"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/StatePrecondition"}
    },
    "lineage": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedDigestRef"}, {"type": "null"}]},
    "policy_decision": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/DigestRef"}, {"type": "null"}]},
    "authority_grant": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/DigestRef"}, {"type": "null"}]},
    "decision_snapshot": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/DigestRef"}, {"type": "null"}]},
    "effect_intent_ref": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}, {"type": "null"}]},
    "capability": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/VersionedRef"}, {"type": "null"}]},
    "evidence_plan_ref": {"anyOf": [{"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"}, {"type": "null"}]},
    "payload_schema": {"type": "string", "minLength": 1},
    "payload_digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"},
    "payload": {"$comment": "TypedValue or SealedRef. Exact typed payload schemas are message-type specific and are intentionally not invented in this common envelope schema."},
    "sensitivity": {"type": "string", "minLength": 1},
    "purpose": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
    "disclosure_scope": {"$comment": "AudienceAndProviderScope; exact nested shape remains message/data-use schema work."},
    "retention_class": {"type": "string", "minLength": 1},
    "trust_taint": {"type": "string", "minLength": 1},
    "deduplication_scope": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Ref"},
    "expiry_or_max_age": {"anyOf": [{"$ref": "urn:noerith:schema:foundation-types:0.1.0#/$defs/Duration"}, {"type": "null"}]},
    "trace_context": {"type": ["object", "null"]},
    "integrity": {
      "type": "object",
      "required": ["producer_auth", "envelope_digest", "payload_digest"],
      "properties": {
        "producer_auth": {"$comment": "ProducerAuth exact mechanism depends on the qualified boundary under O-FC-02."},
        "envelope_digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"},
        "payload_digest": {"$ref": "urn:noerith:schema:common:0.1.0#/$defs/Digest"}
      },
      "additionalProperties": false
    },
    "extensions": {"type": "object"}
  },
  "additionalProperties": false,
  "$comment": "Digest/reference coherence, duplicate-message conflict, authority, freshness and conditional producer/principal requirements are S01 semantic checks."
}
